KICK_CHANNEL=<channelname>
KICK_USERNAME=<botusername>

# Control-command allowlist (comma-separated Kick usernames). These users, plus
# the home-channel broadcaster and anyone with a broadcaster/moderator badge,
# are the ONLY accounts allowed to run +join / +leave. Leave blank to restrict
# control commands to the broadcaster/mods only.
KICK_CONTROL_USERS=

# --- Recommended: official OAuth app credentials (from kick.com developer settings) ---
# When CLIENT_ID + CLIENT_SECRET + an OAuth token are present, the bot sends via
# the official api.kick.com/public/v1/chat endpoint and auto-refreshes on 401/403.
# This is the supported, stable path — prefer it.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Redirect URI registered in your Kick app (must match exactly)
KICK_REDIRECT_URI=http://localhost:3000

# --- Fallback: legacy cookie-based auth (UNOFFICIAL, use at your own risk) ---
# Used only when OAuth creds above are absent. Posts to a private kick.com
# endpoint using a real logged-in browser session. Cookies are short-lived, do
# NOT auto-refresh, and driving Kick this way can get the account actioned.
# Use a disposable/non-personal bot account if you use this path at all.
KICK_AUTH_TOKEN=
KICK_XSRF_TOKEN=
KICK_SESSION_COOKIE=
KICK_COOKIE_HEADER=

KICK_PUSHER_KEY=
KICK_PUSHER_CLUSTER=
KICK_PUSHER_HOST=
# Verbose per-message logging to stdout/docker logs. Off by default (it logs
# every viewer's chat line — a privacy/retention footgun). Set to 1 only while
# actively debugging.
DEBUG_CHAT=0
LOG_CHAT_EVENTS=0
